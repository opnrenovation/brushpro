generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ─────────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  ADMIN
}

enum ContactType {
  PROSPECT
  CUSTOMER
  BOTH
}

enum JobStatus {
  ESTIMATING
  ACTIVE
  INVOICED
  COMPLETE
  CANCELLED
}

enum EstimateStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  VOID
}

enum InvoiceType {
  DEPOSIT
  PROGRESS
  FINAL
}

enum ContractStatus {
  PENDING
  SIGNED
  DECLINED
}

enum PaymentMethod {
  CARD
  CHECK
  CASH
  TRANSFER
}

enum ExpenseCategory {
  MATERIALS
  SUBCONTRACTOR
  EQUIPMENT_RENTAL
  SUPPLIES
  OTHER
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

enum CampaignEventType {
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  UNSUBSCRIBED
  COMPLAINED
}

enum ImportType {
  CONTACTS
  CUSTOMERS
}

enum ExemptionType {
  STATE_EXEMPT
  LOCAL_EXEMPT
  FULLY_EXEMPT
}

enum LeadSource {
  WEBSITE_FORM
  MANUAL
  REFERRAL
  PHONE
  OTHER
}

enum LeadStage {
  NEW
  CONTACTED
  APPOINTMENT
  ESTIMATE_SENT
  NEGOTIATING
  WON
  LOST
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum LeadActivityType {
  STAGE_CHANGE
  NOTE
  EMAIL_SENT
  APPOINTMENT
  CALL
  SYSTEM
}

// ─── Core ──────────────────────────────────────────────────────────────────

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  name                   String
  role                   UserRole
  password_hash          String
  must_change_password   Boolean   @default(false)
  is_active              Boolean   @default(true)
  reset_token_hash       String?
  reset_token_expires_at DateTime?
  last_login_at          DateTime?
  created_at             DateTime  @default(now())

  labor_entries   LaborEntry[]
  email_templates EmailTemplate[]
  campaigns       Campaign[]
  csv_imports     CsvImport[]
  leads_assigned  Lead[]          @relation("AssignedLeads")
  lead_activities LeadActivity[]
  bug_reports     BugReport[]

  @@map("users")
}

model CompanySettings {
  id                     String   @id @default(cuid())
  company_name           String
  logo_url               String?
  address                String?
  phone                  String?
  email                  String?
  website                String?
  license_number         String?
  default_labor_rate     Decimal? @db.Decimal(10, 2)
  default_tax_profile_id String?
  invoice_prefix         String   @default("INV")
  estimate_prefix        String   @default("EST")
  next_invoice_number    Int      @default(1)
  next_estimate_number   Int      @default(1)
  payment_terms_label    String   @default("Due on receipt")
  disclaimer             String?
  invoice_notes          String?
  estimate_notes         String?
  // Deposit / billing settings
  deposit_required       Boolean  @default(true)
  deposit_percentage     Decimal  @default(50.00) @db.Decimal(5, 2)
  deposit_minimum_amount Decimal? @db.Decimal(10, 2)
  // Jobs whose total is below this amount require no deposit at all
  deposit_min_job_total  Decimal  @default(1000.00) @db.Decimal(10, 2)
  deposit_message        String?
  final_payment_message  String?
  payment_terms_days     Int      @default(7)
  estimate_expiry_days   Int      @default(30)
  google_review_url      String?
  updated_at             DateTime @updatedAt

  @@map("company_settings")
}

// ─── CRM ───────────────────────────────────────────────────────────────────

model Company {
  id         String    @id @default(cuid())
  name       String
  phone      String?
  email      String?
  address    String?
  city       String?
  state      String?
  zip        String?
  notes      String?
  deleted_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  contacts Contact[]

  @@map("companies")
}

model Contact {
  id                String      @id @default(cuid())
  type              ContactType @default(PROSPECT)
  first_name        String
  last_name         String
  company           String?
  company_id        String?
  email             String      @unique
  phone             String?
  address           String?
  city              String?
  state             String?
  zip               String?
  tags              String[]    @default([])
  source            String?
  notes             String?
  subscribed        Boolean     @default(true)
  resend_contact_id String?
  deleted_at        DateTime?
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt

  company_rel  Company?            @relation(fields: [company_id], references: [id])
  customer     Customer?           @relation("ContactToCustomer")
  list_members ContactListMember[]
  leads        Lead[]

  @@map("contacts")
}

model ContactList {
  id          String   @id @default(cuid())
  name        String
  description String?
  created_at  DateTime @default(now())

  members ContactListMember[]

  @@map("contact_lists")
}

model ContactListMember {
  id         String   @id @default(cuid())
  list_id    String
  contact_id String
  added_at   DateTime @default(now())

  list    ContactList @relation(fields: [list_id], references: [id], onDelete: Cascade)
  contact Contact     @relation(fields: [contact_id], references: [id], onDelete: Cascade)

  @@unique([list_id, contact_id])
  @@map("contact_list_members")
}

// ─── Lead Pipeline ─────────────────────────────────────────────────────────

model Lead {
  id              String     @id @default(cuid())
  contact_id      String
  source          LeadSource @default(MANUAL)
  service_needed  String?
  project_address String?
  message         String?
  heard_from      String?
  stage           LeadStage  @default(NEW)
  lost_reason     String?
  appointment_id  String?
  estimate_id     String?    @unique
  job_id          String?
  assigned_to     String?
  notes           String?
  converted_at    DateTime?
  deleted_at      DateTime?
  updated_at      DateTime   @updatedAt
  created_at      DateTime   @default(now())

  contact     Contact        @relation(fields: [contact_id], references: [id])
  assignee    User?          @relation("AssignedLeads", fields: [assigned_to], references: [id])
  appointment Appointment?   @relation(fields: [appointment_id], references: [id])
  estimate    Estimate?      @relation(fields: [estimate_id], references: [id])
  job         Job?           @relation(fields: [job_id], references: [id])
  activities  LeadActivity[]

  @@map("leads")
}

model LeadActivity {
  id          String           @id @default(cuid())
  lead_id     String
  user_id     String?
  type        LeadActivityType
  description String
  metadata    Json?
  created_at  DateTime         @default(now())

  lead Lead  @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  user User? @relation(fields: [user_id], references: [id])

  @@map("lead_activities")
}

// ─── Scheduler ─────────────────────────────────────────────────────────────

model AppointmentType {
  id               String   @id @default(cuid())
  name             String
  description      String?
  duration_minutes Int
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())

  appointments Appointment[]

  @@map("appointment_types")
}

model AvailabilityRule {
  id          String  @id @default(cuid())
  day_of_week Int // 0=Sunday … 6=Saturday
  start_time  String // HH:MM 24h
  end_time    String // HH:MM 24h
  is_active   Boolean @default(true)

  @@map("availability_rules")
}

model SchedulerSettings {
  id                      String  @id @default(cuid())
  buffer_minutes          Int     @default(30)
  min_notice_hours        Int     @default(24)
  booking_window_days     Int     @default(60)
  google_calendar_id      String?
  google_refresh_token    String?
  confirmation_email_body String?
  reminder_hours_before   Int     @default(24)

  @@map("scheduler_settings")
}

model Appointment {
  id                  String            @id @default(cuid())
  appointment_type_id String
  lead_id             String?
  contact_id          String?
  first_name          String
  last_name           String
  email               String
  phone               String
  notes               String?
  scheduled_at        DateTime
  duration_minutes    Int
  status              AppointmentStatus @default(SCHEDULED)
  google_event_id     String?
  cancelled_at        DateTime?
  created_at          DateTime          @default(now())

  appointment_type AppointmentType @relation(fields: [appointment_type_id], references: [id])
  leads            Lead[]

  @@map("appointments")
}

// ─── Contracts ─────────────────────────────────────────────────────────────

model ContractTemplate {
  id                String   @id @default(cuid())
  name              String
  description       String?
  body_text         String
  requires_initials Boolean  @default(false)
  signature_label   String   @default("Customer Signature")
  company_sig_label String?
  is_default        Boolean  @default(false)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  estimates Estimate[]
  contracts Contract[]

  @@map("contract_templates")
}

model Contract {
  id                   String         @id @default(cuid())
  estimate_id          String         @unique
  job_id               String
  contract_template_id String?
  body_text            String
  status               ContractStatus @default(PENDING)
  customer_name_signed String?
  signature_url        String?
  initials_data        Json?
  ip_address           String?
  signed_at            DateTime?
  pdf_url              String?
  created_at           DateTime       @default(now())

  estimate          Estimate          @relation(fields: [estimate_id], references: [id])
  job               Job               @relation(fields: [job_id], references: [id])
  contract_template ContractTemplate? @relation(fields: [contract_template_id], references: [id])

  @@map("contracts")
}

// ─── Estimates ─────────────────────────────────────────────────────────────

model Estimate {
  id                        String         @id @default(cuid())
  job_id                    String?
  lead_id                   String?
  estimate_number           String         @unique
  status                    EstimateStatus @default(DRAFT)
  line_items                Json           @default("[]")
  tax_profile_id            String
  contract_template_id      String?
  notes                     String?
  approval_token            String?        @unique
  approval_token_expires_at DateTime?
  expiry_days               Int?
  approved_at               DateTime?
  rejected_at               DateTime?
  rejection_note            String?
  paint_codes               Json?
  client_notes              String?
  resend_email_id           String?
  sent_at                   DateTime?
  email_delivered_at        DateTime?
  email_opened_at           DateTime?
  email_clicked_at          DateTime?
  deleted_at                DateTime?
  created_at                DateTime       @default(now())

  job               Job?              @relation(fields: [job_id], references: [id])
  lead              Lead?
  tax_profile       TaxProfile        @relation(fields: [tax_profile_id], references: [id])
  contract_template ContractTemplate? @relation(fields: [contract_template_id], references: [id])
  contracts         Contract[]
  invoices          Invoice[]

  @@map("estimates")
}

// ─── Jobs ──────────────────────────────────────────────────────────────────

model Customer {
  id         String    @id @default(cuid())
  contact_id String?   @unique
  name       String
  email      String?
  phone      String?
  address    String
  notes      String?
  deleted_at DateTime?
  created_at DateTime  @default(now())

  contact  Contact?  @relation("ContactToCustomer", fields: [contact_id], references: [id])
  jobs     Job[]
  invoices Invoice[]

  @@map("customers")
}

model Job {
  id           String    @id @default(cuid())
  customer_id  String
  name         String
  address      String
  municipality String
  status       JobStatus @default(ESTIMATING)
  tax_exempt   Boolean   @default(false)
  start_date   DateTime?
  end_date     DateTime?
  labor_rate   Decimal   @db.Decimal(10, 2)
  notes        String?
  // Instructions shown to assigned crew in the crew app (never prices)
  crew_notes   String?
  deleted_at   DateTime?
  updated_at   DateTime  @updatedAt
  created_at   DateTime  @default(now())

  customer     Customer        @relation(fields: [customer_id], references: [id])
  estimates    Estimate[]
  invoices     Invoice[]
  labor        LaborEntry[]
  expenses     Expense[]
  contracts    Contract[]
  leads        Lead[]
  time_entries TimeEntry[]
  crew         JobAssignment[]
  crew_updates JobCrewUpdate[]

  @@map("jobs")
}

model MaterialItem {
  id         String   @id @default(cuid())
  name       String
  sku        String?
  vendor     String?
  category   String
  unit       String
  our_cost   Decimal  @db.Decimal(10, 2)
  is_active  Boolean  @default(true)
  notes      String?
  updated_at DateTime @updatedAt
  created_at DateTime @default(now())

  @@map("material_items")
}

// ─── Invoicing ─────────────────────────────────────────────────────────────

model Invoice {
  id                 String        @id @default(cuid())
  job_id             String?
  customer_id        String?
  estimate_id        String?
  invoice_number     String        @unique
  type               InvoiceType
  status             InvoiceStatus @default(DRAFT)
  line_items         Json          @default("[]")
  tax_profile_id     String
  discount_type      String?       @default("NONE")
  discount_value     Decimal?      @default(0) @db.Decimal(10, 2)
  due_date           DateTime
  notes              String?
  pdf_url            String?
  stripe_link        String?
  sent_at            DateTime?
  // Delivery tracking for the customer-facing copy (see lib/sendInvoice.ts).
  // The internal copy goes out as a separate untagged email so that staff
  // opening their copy never registers as the customer opening theirs.
  resend_email_id    String?
  email_delivered_at DateTime?
  email_opened_at    DateTime?
  email_clicked_at   DateTime?
  // Guard so the "invoice opened" alert fires once per send, not per open.
  open_notified_at   DateTime?
  deleted_at         DateTime?
  updated_at         DateTime      @updatedAt
  created_at         DateTime      @default(now())

  job              Job?             @relation(fields: [job_id], references: [id])
  customer         Customer?        @relation(fields: [customer_id], references: [id])
  estimate         Estimate?        @relation(fields: [estimate_id], references: [id])
  tax_profile      TaxProfile       @relation(fields: [tax_profile_id], references: [id])
  payments         Payment[]
  exemptions       TaxExemption[]
  feedback_request FeedbackRequest?

  @@map("invoices")
}

model FeedbackRequest {
  id           String    @id @default(cuid())
  invoice_id   String    @unique
  email        String?
  token        String    @unique @default(cuid())
  sent_at      DateTime?
  completed_at DateTime?
  rating       Int?
  comments     String?
  created_at   DateTime  @default(now())

  invoice Invoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade)

  @@index([email, created_at])
  @@map("feedback_requests")
}

model TaxProfile {
  id            String   @id @default(cuid())
  name          String
  state_code    String
  state_rate    Decimal  @db.Decimal(6, 4)
  local_rate    Decimal  @db.Decimal(6, 4)
  municipality  String
  county        String?
  taxable_labor Boolean  @default(false)
  is_default    Boolean  @default(false)
  created_at    DateTime @default(now())

  estimates Estimate[]
  invoices  Invoice[]

  @@map("tax_profiles")
}

model TaxExemption {
  id                 String        @id @default(cuid())
  invoice_id         String        @unique
  exemption_type     ExemptionType
  reason             String
  certificate_number String?
  created_at         DateTime      @default(now())

  invoice Invoice @relation(fields: [invoice_id], references: [id])

  @@map("tax_exemptions")
}

model Payment {
  id         String        @id @default(cuid())
  invoice_id String
  amount     Decimal       @db.Decimal(10, 2)
  method     PaymentMethod
  stripe_id  String?
  paid_at    DateTime
  notes      String?
  created_at DateTime      @default(now())

  invoice Invoice @relation(fields: [invoice_id], references: [id])

  @@map("payments")
}

// ─── Labor & Expenses ──────────────────────────────────────────────────────

model LaborEntry {
  id          String   @id @default(cuid())
  job_id      String
  user_id     String
  description String
  hours       Decimal  @db.Decimal(6, 2)
  rate        Decimal  @db.Decimal(10, 2)
  work_date   DateTime
  created_at  DateTime @default(now())

  job  Job  @relation(fields: [job_id], references: [id])
  user User @relation(fields: [user_id], references: [id])

  @@map("labor_entries")
}

model Expense {
  id           String          @id @default(cuid())
  job_id       String
  vendor       String
  description  String
  amount       Decimal         @db.Decimal(10, 2)
  expense_date DateTime
  category     ExpenseCategory
  receipt_url  String?
  notes        String?
  created_at   DateTime        @default(now())

  job Job @relation(fields: [job_id], references: [id])

  @@map("expenses")
}

// ─── Email Marketing ───────────────────────────────────────────────────────

model EmailTemplate {
  id            String   @id @default(cuid())
  name          String
  subject       String
  html_body     String
  preview_text  String?
  thumbnail_url String?
  created_by    String
  updated_at    DateTime @updatedAt
  created_at    DateTime @default(now())

  creator   User       @relation(fields: [created_by], references: [id])
  campaigns Campaign[]

  @@map("email_templates")
}

model Campaign {
  id                  String         @id @default(cuid())
  name                String
  subject             String
  preview_text        String?
  html_body           String
  template_id         String?
  list_ids            String[]       @default([])
  status              CampaignStatus @default(DRAFT)
  scheduled_at        DateTime?
  sent_at             DateTime?
  total_recipients    Int            @default(0)
  resend_broadcast_id String?
  created_by          String
  created_at          DateTime       @default(now())
  updated_at          DateTime       @updatedAt

  creator  User            @relation(fields: [created_by], references: [id])
  template EmailTemplate?  @relation(fields: [template_id], references: [id])
  events   CampaignEvent[]

  @@map("campaigns")
}

model CampaignEvent {
  id            String            @id @default(cuid())
  campaign_id   String
  contact_id    String
  event_type    CampaignEventType
  resend_msg_id String?
  link_url      String?
  occurred_at   DateTime          @default(now())

  campaign Campaign @relation(fields: [campaign_id], references: [id], onDelete: Cascade)

  @@map("campaign_events")
}

// ─── Vendors ───────────────────────────────────────────────────────────────

enum VendorCategory {
  PAINT_SUPPLIER
  EQUIPMENT
  SUBCONTRACTOR
  MATERIALS
  OTHER
}

model Vendor {
  id           String         @id @default(cuid())
  name         String
  category     VendorCategory @default(OTHER)
  contact_name String?
  email        String?
  phone        String?
  address      String?
  notes        String?
  deleted_at   DateTime?
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt

  @@map("vendors")
}

// ─── Imports ───────────────────────────────────────────────────────────────

model CsvImport {
  id          String     @id @default(cuid())
  import_type ImportType
  filename    String
  total_rows  Int
  imported    Int        @default(0)
  skipped     Int        @default(0)
  errors      Int        @default(0)
  error_log   Json?
  imported_by String
  created_at  DateTime   @default(now())

  importer User @relation(fields: [imported_by], references: [id])

  @@map("csv_imports")
}

// ─── Employees & Payroll ───────────────────────────────────────────────────

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum WorkerType {
  W2
  CONTRACTOR_1099
}

enum PayType {
  HOURLY
  SALARY
}

enum PayFrequency {
  WEEKLY
  BIWEEKLY
  SEMIMONTHLY
  MONTHLY
}

enum PayRunStatus {
  DRAFT
  FINALIZED
  PAID
}

model Employee {
  id                      String         @id @default(cuid())
  first_name              String
  last_name               String
  email                   String?
  phone                   String?
  address                 String?
  position                String?
  status                  EmployeeStatus @default(ACTIVE)
  worker_type             WorkerType     @default(W2)
  pay_type                PayType        @default(HOURLY)
  // Hourly rate for HOURLY, annual salary for SALARY
  pay_rate                Decimal        @db.Decimal(10, 2)
  overtime_eligible       Boolean        @default(true)
  // Flat withholding percentages applied each pay run (W2 only). These are
  // estimates the owner sets from the employee's W-4 / IA W-4.
  federal_withholding_pct Decimal        @default(0) @db.Decimal(5, 2)
  state_withholding_pct   Decimal        @default(0) @db.Decimal(5, 2)
  hire_date               DateTime?
  termination_date        DateTime?
  emergency_contact_name  String?
  emergency_contact_phone String?
  notes                   String?
  // Crew app (/crew) login: email or phone + PIN
  app_access              Boolean        @default(false)
  pin_hash                String?
  failed_pin_attempts     Int            @default(0)
  pin_locked_until        DateTime?
  last_app_login_at       DateTime?
  deleted_at              DateTime?
  created_at              DateTime       @default(now())
  updated_at              DateTime       @updatedAt

  time_entries    TimeEntry[]
  pay_stubs       PayStub[]
  job_assignments JobAssignment[]
  job_updates     JobCrewUpdate[]
  time_off        TimeOffRequest[]
  // Announcements newer than this show as unread in the crew app
  news_read_at    DateTime?

  @@map("employees")
}

enum TimeEntryStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TimeEntrySource {
  OWNER
  CREW
  // Missed time a crew member added by hand in the crew app (no real clock-in)
  CREW_MANUAL
}

model TimeEntry {
  id             String          @id @default(cuid())
  employee_id    String
  job_id         String?
  work_date      DateTime
  // Total worked hours. 0 while the employee is still clocked in.
  hours          Decimal         @db.Decimal(6, 2)
  clock_in       DateTime?
  clock_out      DateTime?
  break_minutes  Int             @default(0)
  // Only APPROVED entries are paid. Crew entries start PENDING.
  status         TimeEntryStatus @default(APPROVED)
  source         TimeEntrySource @default(OWNER)
  reviewed_at    DateTime?
  reviewed_by    String?
  review_note    String?
  // The office changed the times after the fact (shown as OFFICE EDIT)
  office_edited  Boolean         @default(false)
  // Where the phone was at each punch (only when the crew member allowed it)
  in_lat         Float?
  in_lng         Float?
  in_accuracy_m  Int?
  out_lat        Float?
  out_lng        Float?
  out_accuracy_m Int?
  // Punched with no signal and sent later from the phone's queue
  synced_late    Boolean         @default(false)
  notes          String?
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt

  employee Employee @relation(fields: [employee_id], references: [id])
  job      Job?     @relation(fields: [job_id], references: [id])

  @@index([employee_id, work_date])
  @@map("time_entries")
}

model PayRun {
  id                   String       @id @default(cuid())
  period_start         DateTime
  period_end           DateTime
  pay_date             DateTime
  frequency            PayFrequency @default(BIWEEKLY)
  status               PayRunStatus @default(DRAFT)
  notes                String?
  total_gross          Decimal      @default(0) @db.Decimal(12, 2)
  total_deductions     Decimal      @default(0) @db.Decimal(12, 2)
  total_net            Decimal      @default(0) @db.Decimal(12, 2)
  total_employer_taxes Decimal      @default(0) @db.Decimal(12, 2)
  finalized_at         DateTime?
  paid_at              DateTime?
  created_by           String?
  created_at           DateTime     @default(now())
  updated_at           DateTime     @updatedAt

  stubs PayStub[]

  @@map("pay_runs")
}

model PayStub {
  id                       String         @id @default(cuid())
  pay_run_id               String
  employee_id              String
  worker_type              WorkerType
  pay_type                 PayType
  pay_rate                 Decimal        @db.Decimal(10, 2)
  regular_hours            Decimal        @default(0) @db.Decimal(7, 2)
  overtime_hours           Decimal        @default(0) @db.Decimal(7, 2)
  regular_pay              Decimal        @default(0) @db.Decimal(10, 2)
  overtime_pay             Decimal        @default(0) @db.Decimal(10, 2)
  bonus                    Decimal        @default(0) @db.Decimal(10, 2)
  // Non-taxable, added to net (mileage, materials bought out of pocket)
  reimbursement            Decimal        @default(0) @db.Decimal(10, 2)
  gross_pay                Decimal        @default(0) @db.Decimal(10, 2)
  federal_withholding      Decimal        @default(0) @db.Decimal(10, 2)
  state_withholding        Decimal        @default(0) @db.Decimal(10, 2)
  social_security          Decimal        @default(0) @db.Decimal(10, 2)
  medicare                 Decimal        @default(0) @db.Decimal(10, 2)
  other_deductions         Decimal        @default(0) @db.Decimal(10, 2)
  other_deductions_note    String?
  net_pay                  Decimal        @default(0) @db.Decimal(10, 2)
  employer_social_security Decimal        @default(0) @db.Decimal(10, 2)
  employer_medicare        Decimal        @default(0) @db.Decimal(10, 2)
  payment_method           PaymentMethod?
  check_number             String?
  notes                    String?
  created_at               DateTime       @default(now())
  updated_at               DateTime       @updatedAt

  pay_run  PayRun   @relation(fields: [pay_run_id], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employee_id], references: [id])

  @@unique([pay_run_id, employee_id])
  @@map("pay_stubs")
}

// ─── Bug Reports ───────────────────────────────────────────────────────────

enum BugReportType {
  BUG
  FEATURE_REQUEST
  QUESTION
}

enum BugReportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum BugReportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  WONT_FIX
}

model BugReport {
  id               String            @id @default(cuid())
  type             BugReportType     @default(BUG)
  priority         BugReportPriority @default(NORMAL)
  status           BugReportStatus   @default(OPEN)
  title            String
  description      String
  page_url         String?
  user_agent       String?
  // Optional screenshot as a data: URL (kept small client-side)
  screenshot       String?
  reported_by      String?
  resolution_notes String?
  resolved_at      DateTime?
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt

  reporter User? @relation(fields: [reported_by], references: [id])

  @@index([status, created_at])
  @@map("bug_reports")
}

// ─── Crew app ──────────────────────────────────────────────────────────────

model JobAssignment {
  id          String   @id @default(cuid())
  job_id      String
  employee_id String
  created_at  DateTime @default(now())

  job      Job      @relation(fields: [job_id], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@unique([job_id, employee_id])
  @@map("job_assignments")
}

// Progress notes and photos the crew posts from the job site
model JobCrewUpdate {
  id          String   @id @default(cuid())
  job_id      String
  employee_id String
  body        String
  // Optional photo as a data: URL (downscaled client-side)
  photo       String?
  created_at  DateTime @default(now())

  job      Job      @relation(fields: [job_id], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@index([job_id, created_at])
  @@map("job_crew_updates")
}

// ─── Time off & announcements (crew app) ───────────────────────────────────

enum TimeOffKind {
  // "Can't make it today": reported, never up for approval
  CALL_OFF
  REQUEST
}

enum TimeOffStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}

model TimeOffRequest {
  id            String        @id @default(cuid())
  employee_id   String
  kind          TimeOffKind
  // Code such as sick, vacation, child_care; shown in each person's language
  reason        String
  starts_on     DateTime
  ends_on       DateTime
  note          String?
  status        TimeOffStatus @default(PENDING)
  decision_note String?
  decided_at    DateTime?
  decided_by    String?
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt

  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@index([employee_id, starts_on])
  @@index([status, starts_on])
  @@map("time_off_requests")
}

model Announcement {
  id           String   @id @default(cuid())
  title        String
  body         String
  published_at DateTime @default(now())
  created_by   String?
  created_at   DateTime @default(now())

  @@index([published_at])
  @@map("announcements")
}
